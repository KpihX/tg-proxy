# tg — required secrets template
# Copy to src/tg/.env for local dev overrides
# In production: injected by bw-env from Bitwarden GLOBAL_ENV_VARS

# ── Bot tokens (auto-discovered — one per bot) ──────────────────────────────
# Naming: TELEGRAM_<ALIAS>_TOKEN → alias is lowercased with - replacing _
TELEGRAM_HOMELAB_TOKEN=your_homelab_bot_token_here
TELEGRAM_UBUNTU_TOKEN=your_ubuntu_bot_token_here
TELEGRAM_N8N_HOMELAB_TOKEN=your_n8n_bot_token_here

# ── Global defaults ──────────────────────────────────────────────────────────
CHAT_ID=your_default_chat_id_here

# ── Telethon user API (from https://my.telegram.org → API development tools) ─
TG_API_ID=12345
TG_API_HASH=your_api_hash_here
